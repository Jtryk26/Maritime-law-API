# =============================================================================
# Maritim Lovdatabase — miljøvariabler
# =============================================================================
# Kopiér til .env og tilpas:   cp .env.example .env
# .env er i .gitignore og må ikke committes.
#
# Bemærk: Retsinformations høsteservice kræver INGEN API-nøgle. Der er
# derfor bevidst ingen RETSINFORMATION_API_KEY her.
# =============================================================================

# --- Applikation -------------------------------------------------------------
ENVIRONMENT=development
LOG_LEVEL=INFO

# --- Database ----------------------------------------------------------------
# PostgreSQL i Docker (bruges af docker-compose):
DATABASE_URL=postgresql+psycopg://maritim:maritim@localhost:5432/maritim
# Lokal kørsel uden PostgreSQL — SQLite understøttes til udvikling og test:
# DATABASE_URL=sqlite:///./data/maritime.db

POSTGRES_USER=maritim
# Standardværdien er til lokal udvikling. Skal systemet nås udefra —
# også gennem Cloudflare Tunnel — SKAL kodeordet skiftes. Tunnel-
# opsætningen nægter at starte, hvis værdien ikke er sat eksplicit.
POSTGRES_PASSWORD=maritim
POSTGRES_DB=maritim
POSTGRES_PORT=5432

# Kør Alembic-migrationer ved opstart. Praktisk i Docker; slå fra hvis
# migrationer styres af en separat udrulningsproces.
RUN_MIGRATIONS_ON_STARTUP=true

# --- Kilde -------------------------------------------------------------------
# "fixture"    = lokale SYNTETISKE testdata (udvikling og demonstration)
# "production" = Retsinformations officielle høsteservice
#
# Værdien skal være en af de to. Systemet falder ALDRIG tilbage til
# fixture, hvis produktionskilden fejler — syntetiske dokumenter må aldrig
# kunne forveksles med gældende ret.
SOURCE_CLIENT=production

RETSINFORMATION_BASE_URL=https://api.retsinformation.dk
RETSINFORMATION_DOCUMENT_BASE_URL=https://www.retsinformation.dk
RETSINFORMATION_TIMEOUT_SECONDS=30
RETSINFORMATION_MAX_RETRIES=3
# Kildens dokumenterede grænse er ét kald pr. 10 sekunder. Sænk ikke
# denne værdi uden aftale med Civilstyrelsen.
RETSINFORMATION_MIN_REQUEST_INTERVAL_SECONDS=10

# --- Søgning (opdagelse af accessionsnumre) ----------------------------------
# Høsteservicen er en ændringsfeed og kan ikke liste lovsamlingen. Kandidater
# findes via søgesiden på www.retsinformation.dk — men dens dataendpoint er
# IKKE en dokumenteret grænseflade. Derfor er der bevidst ingen standard-URL:
# en gættet URL ville ligne en færdig integration og fejle stille.
#
# Sådan findes værdierne:
#   1. Åbn https://www.retsinformation.dk/documents og browserens netværksfane.
#   2. Søg med administrerendeMyndighed = Søfartsstyrelsen.
#   3. Aflæs anmodningens URL, metode og parametre, og skriv dem herunder.
#   4. Kontrollér:  python -m app.cli backfill probe-search --out probe.json
#
# Uden disse værdier virker `backfill discover` ikke. Resten af systemet —
# daglig import, kø, søgning, API, frontend — er upåvirket.
RETSINFORMATION_SEARCH_URL=
RETSINFORMATION_SEARCH_METHOD=GET
# Parametrene som JSON. Pladsholdere: {authority} {status} {page} {page_size}
# {offset}. En værdi der kun består af en numerisk pladsholder sendes som tal.
# Eksempel (feltnavnene skal rettes til dem der faktisk aflæses):
# RETSINFORMATION_SEARCH_PARAMS={"administrerendeMyndighed":"{authority}","retsinformationStatus":"{status}","page":"{page}","pageSize":"{page_size}"}
RETSINFORMATION_SEARCH_PARAMS=
RETSINFORMATION_SEARCH_PAGE_SIZE=100
# "page" (sidetal) eller "offset" (springtal).
RETSINFORMATION_SEARCH_PAGINATION=page
# Er første side 0 eller 1?
RETSINFORMATION_SEARCH_FIRST_PAGE=1
# Loft mod uendelige løkker, hvis pagineringen opfører sig uventet.
RETSINFORMATION_SEARCH_MAX_PAGES=200
# Søgesiden har ingen publiceret grænse; vi begrænser os selv alligevel.
RETSINFORMATION_SEARCH_MIN_REQUEST_INTERVAL_SECONDS=2

# --- Import ------------------------------------------------------------------
# Dokumenter med maritim score under denne værdi gemmes ikke. Sat til
# "mulig maritim relevans"-tærsklen, så grænsetilfælde kan inspiceres.
IMPORT_STORE_MIN_SCORE=30
# Antal fejl i træk før en kørsel afbrydes som usund.
IMPORT_MAX_CONSECUTIVE_FAILURES=25

# --- Semantisk søgning (vektorer) --------------------------------------------
# Vektorlaget gør søgningen i stand til at finde dokumenter, der handler om
# det samme, men bruger andre ord — "livbåd" finder også "redningsflåde".
#
# Slås det fra, opfører systemet sig præcis som før: leksikalsk søgning
# alene, ingen model indlæses, ingen vektorer skrives.
EMBEDDINGS_ENABLED=true

# local   = sentence-transformers i backend-containeren. Standard. Ingen
#           API-nøgle, intet netværk, dokumenterne forlader ikke maskinen.
# api     = OpenAI-kompatibelt endpoint. Kræver EMBEDDING_API_URL.
# hashing = deterministisk hash. IKKE semantisk. Kun til test.
#
# Der falder ALDRIG automatisk tilbage fra én udbyder til en anden: et halvt
# indeks bygget med to modeller ville give resultater, ingen kan forklare.
EMBEDDING_PROVIDER=local

# Modellen. multilingual-e5-small er flersproget (dansk indgår), 384
# dimensioner og kører på CPU. Skiftes modellen, SKAL dimensionen rettes
# tilsvarende — kontrollér med: python -m app.cli embed model-info
EMBEDDING_MODEL=intfloat/multilingual-e5-small
EMBEDDING_DIMENSIONS=384

# E5 er trænet asymmetrisk: tekst der indekseres får "passage: " foran,
# en søgning får "query: ". Uden præfikserne falder kvaliteten mærkbart.
# Sæt dem tomme for modeller uden præfikskrav.
EMBEDDING_QUERY_PREFIX=query: 
EMBEDDING_PASSAGE_PREFIX=passage: 
EMBEDDING_BATCH_SIZE=16
# 0 = lad torch selv vælge antal CPU-tråde.
EMBEDDING_TORCH_THREADS=0

# Kun ved EMBEDDING_PROVIDER=api. Ingen udbyder er hardcodet — URL'en
# sættes her, ligesom Retsinformation-konnektorens. Bemærk at et eksternt
# endpoint sender dokumentteksten ud af huset.
EMBEDDING_API_URL=
EMBEDDING_API_KEY=

# --- Chunking ----------------------------------------------------------------
# Lovtekster deles i stykker før vektorisering, så et søgehit svarer til en
# bestemmelse frem for til et helt dokuments gennemsnit. Snittene lægges så
# vidt muligt på §- og kapitelgrænser.
CHUNK_TARGET_CHARS=1200
CHUNK_MAX_CHARS=2000
CHUNK_OVERLAP_CHARS=150
CHUNK_MIN_CHARS=120
CHUNK_MAX_PER_DOCUMENT=400

# --- Søgetilstand ------------------------------------------------------------
# lexical  = ordene skal stå der.
# semantic = betydningen skal ligne.
# hybrid   = begge dele, smeltet sammen med Reciprocal Rank Fusion.
# Findes der ingen vektorer, nedgraderes der til lexical — og det står i
# svaret, så ingen tror der blev søgt bredere end der blev.
SEARCH_DEFAULT_MODE=hybrid

# Kandidater pr. delsøgning før sammensmeltning. `total` i et hybridsvar
# tæller kandidater, ikke hele databasen.
HYBRID_CANDIDATE_LIMIT=200
# RRF-konstanten. 60 er værdien fra litteraturen.
HYBRID_RRF_K=60
# Vægte. Leksikalsk vejer tungest: en paragrafhenvisning er ikke et tema.
HYBRID_LEXICAL_WEIGHT=1.0
HYBRID_SEMANTIC_WEIGHT=0.8

# Nedre grænse for hvad der tælles som et semantisk hit. Tom = brug
# udbyderens eget forslag (0,75 for E5). Skalaen afhænger fuldstændig af
# modellen; sæt kun en værdi her, når du har målt på netop din.
VECTOR_MIN_SIMILARITY=
# Loft for den portable vektorsammenligning (SQLite eller PostgreSQL uden
# pgvector). Over dette antal stykker er svartiden ikke forsvarlig.
VECTOR_FALLBACK_MAX_CHUNKS=20000

# --- Søgelog -----------------------------------------------------------------
# Logger og vektoriserer de søgninger der stilles. Grundlaget for
# "relaterede søgninger" og for listen over søgninger uden svar.
# Der gemmes hverken bruger, IP-adresse eller session.
SEARCH_QUERY_LOG_ENABLED=true
SEARCH_QUERY_LOG_MIN_CHARS=2
RELATED_QUERY_MIN_SIMILARITY=0.55

# --- Netværk -----------------------------------------------------------------
BACKEND_PORT=8000
FRONTEND_PORT=8080

# Hvilken adresse Docker binder portene til. 127.0.0.1 betyder "kun denne
# maskine" — tjenesterne taler sammen over Docker-netværket og har ikke
# brug for at være synlige udadtil. Sæt til 0.0.0.0, hvis du bevidst vil
# nå systemet fra en anden maskine på dit eget net.
# I tunnel-opsætningen fjernes portbindingerne helt.
BIND_ADDRESS=127.0.0.1

# Browsere må kun kalde API'et fra disse oprindelser. I den udrullede
# opsætning serverer nginx frontend og API fra samme domæne; da skal
# værdien være TOM. Værdierne herunder gælder udvikling med Vite.
# "*" afvises i produktion.
CORS_ORIGINS=http://localhost:8080,http://localhost:5173

# =============================================================================
# --- Adgangskontrol ----------------------------------------------------------
# =============================================================================
# Beskytter alt, der skriver eller afslører drift:
#   POST /api/import/run          kør en import
#   POST /api/embeddings/run      byg det semantiske indeks
#   GET  /api/import/runs         importhistorik
#   GET  /api/stats               nøgletal
#   GET  /api/embeddings/status   indeksets tilstand
#   GET  /api/search/queries      søgeloggen
#   GET  /api/search/related      søgeloggen
#
# Sendes af klienten som:  Authorization: Bearer <token>
#
# Generér et token:
#   cd backend && python -m app.cli admin-token
#   docker compose run --rm backend python -m app.cli admin-token
#
# Er værdien tom, svarer endepunkterne 503 — de står altså ALDRIG åbne
# ved et uheld. Med ENVIRONMENT=production nægter backenden at starte
# uden token.
ADMIN_API_TOKEN=

# =============================================================================
# --- Rate limiting (indgående) -----------------------------------------------
# =============================================================================
# Grænser pr. klient-IP pr. minut. Håndhæves både i nginx (foran) og i
# backenden (så grænsen også gælder ved direkte adgang til API'et).
# Ændrer du tallene her, skal limit_req_zone i frontend/nginx.conf følge med.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS_PER_MINUTE=120
RATE_LIMIT_SEARCH_PER_MINUTE=30

# Stol på CF-Connecting-IP og X-Forwarded-For ved bestemmelse af klientens
# adresse. SKAL kun være true, når applikationen står bag en proxy, du selv
# kontrollerer (nginx, cloudflared) — ellers kan enhver forfalske sin
# adresse og dermed omgå rate limiting. I docker-compose er det tilfældet.
TRUST_PROXY_HEADERS=true

# Udstil /docs, /redoc og /openapi.json. Skemaet beskriver hele
# driftsgrænsefladen; sæt false når tjenesten er offentligt tilgængelig.
EXPOSE_API_DOCS=true

# =============================================================================
# --- Offentlig udgivelse: Cloudflare Tunnel ----------------------------------
# =============================================================================
# Bruges KUN af docker-compose.tunnel.yml. Se
# docs/deployment-cloudflare-tunnel.md for hele fremgangsmåden.
#
# Tokenet hentes i Cloudflare Zero Trust:
#   Networks > Tunnels > (din tunnel) > Configure > Docker
# Det er en hemmelighed på linje med et kodeord og må ikke committes.
TUNNEL_TOKEN=
TUNNEL_LOGLEVEL=info

# FØR DU ÅBNER FOR OMVERDENEN
#   [ ] ADMIN_API_TOKEN er sat til noget tilfældigt og langt
#   [ ] POSTGRES_PASSWORD er IKKE længere "maritim"
#   [ ] ENVIRONMENT=production
#   [ ] EXPOSE_API_DOCS=false
#   [ ] CORS_ORIGINS er tom
#   [ ] Ingen porte er videresendt i routeren — tunnelen ringer selv ud
